@import "styles/handwriting.wxss";
@import "styles/typography.wxss";
page { background: #fdfcf9; color: #262622; font-family: 'PaoxiaHand', cursive; }
.screen { box-sizing: border-box; min-height: 100vh; padding: 104px 44rpx 32px; padding-top: max(104px, var(--safe-top, 96px)); padding-bottom: calc(32px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; }
.handwritten { font-family: 'PaoxiaHand', cursive; font-weight: 600; }
.home .handwritten { font-family: 'Kalam', cursive; font-weight: 700; }
.runner { display: block; }
.screen .pill, .recap .pill { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 144rpx; min-height: max(48px, 144rpx); flex-shrink: 0; margin: 0; padding: 0 24rpx 6rpx; border: 2px solid #30312a; border-radius: 76rpx 72rpx 78rpx 70rpx; background: transparent; color: #262622; font-size: 86rpx; line-height: 1; }
.pill::after, .return-link::after { border: 0; }
.pressed { opacity: .65; transform: scale(.985); }
.actions { width: 100%; max-width: 570rpx; }
