<view class="recap" style="--safe-top: {{safeTop}}px;">
  <view class="recap-inner">
    <view class="recap-heading-row">
      <view>
        <text class="handwritten recap-title">{{editing ? 'Edit' : 'So?'}}</text>
        <text class="handwritten recap-duration">{{durationText}}</text>
      </view>
      <button class="weather-trigger weather-{{weather || 'none'}} {{weatherOpen ? 'open' : ''}}" disabled="{{editing}}" bindtap="toggleWeather" hover-class="choice-pressed" aria-label="{{editing ? '原记录天气：' : '选择天气，当前为'}}{{weatherLabel}}">
        <text class="weather-glyph" aria-hidden="true">{{weatherGlyph}}</text>
        <text class="handwritten weather-caption">Weather</text>
      </button>
      <view wx:if="{{weatherOpen}}" class="weather-menu" aria-label="天气选项">
        <button class="weather-option {{weather === item.value ? 'selected' : ''}}" wx:for="{{weatherOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseWeather" hover-class="choice-pressed" aria-label="{{item.label}}">
          <text class="weather-option-glyph {{item.value}}" aria-hidden="true">{{item.glyph}}</text>
          <text class="handwritten weather-option-label">{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="section">
      <text class="handwritten section-title">How was it?</text>
      <view class="mood-grid">
        <button class="choice mood-choice {{mood === 'good' ? 'selected mood-green' : ''}}" data-value="good" bindtap="chooseMood" hover-class="choice-pressed" aria-label="心情不错">
          <view class="face face-good"><view class="eyes"></view><view class="mouth"></view></view>
          <text class="choice-label handwritten">Good</text>
        </button>
        <button class="choice mood-choice {{mood === 'calm' ? 'selected mood-green' : ''}}" data-value="calm" bindtap="chooseMood" hover-class="choice-pressed" aria-label="心情平静">
          <view class="face face-calm"><view class="eyes"></view><view class="mouth"></view></view>
          <text class="choice-label handwritten">Calm</text>
        </button>
        <button class="choice mood-choice {{mood === 'tired' ? 'selected mood-green' : ''}}" data-value="tired" bindtap="chooseMood" hover-class="choice-pressed" aria-label="感觉疲惫">
          <view class="face face-tired"><view class="eyes"></view><view class="mouth"></view></view>
          <text class="choice-label handwritten">Tired</text>
        </button>
        <button class="choice mood-choice {{mood === 'unsure' ? 'selected mood-green' : ''}}" data-value="unsure" bindtap="chooseMood" hover-class="choice-pressed" aria-label="不太确定">
          <text class="question-mark handwritten">?</text>
          <view class="face face-unsure"><view class="eyes"></view><view class="mouth"></view></view>
          <text class="choice-label handwritten">Not sure</text>
        </button>
      </view>
    </view>

    <view class="section notice-section">
      <text class="handwritten section-title">What did you notice?</text>
      <view class="notice-grid">
        <button class="choice notice-choice {{selectedNotices.tree ? 'selected notice-red' : ''}}" data-value="tree" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="看见树">
          <view class="pictogram tree-icon"><view class="tree-crown crown-a"></view><view class="tree-crown crown-b"></view><view class="tree-crown crown-c"></view><view class="tree-trunk"></view><view class="tree-branch"></view></view>
          <text class="choice-label handwritten">Tree</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.wind ? 'selected notice-red' : ''}}" data-value="wind" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="感到风">
          <view class="pictogram wind-icon"><view class="wind-line wind-a"></view><view class="wind-line wind-b"></view><view class="wind-line wind-c"></view></view>
          <text class="choice-label handwritten">Wind</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cloud ? 'selected notice-red' : ''}}" data-value="cloud" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="看见云">
          <view class="pictogram cloud-icon"><view class="cloud-puff puff-a"></view><view class="cloud-puff puff-b"></view><view class="cloud-puff puff-c"></view><view class="cloud-base"></view></view>
          <text class="choice-label handwritten">Cloud</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cat ? 'selected notice-red' : ''}}" data-value="cat" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="看见猫">
          <view class="pictogram cat-icon"><view class="cat-head"><view class="cat-ear cat-ear-a"></view><view class="cat-ear cat-ear-b"></view><view class="cat-face"></view></view><view class="cat-body"></view><view class="cat-leg cat-leg-a"></view><view class="cat-leg cat-leg-b"></view><view class="cat-tail"></view></view>
          <text class="choice-label handwritten">Cat</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.streetlight ? 'selected notice-red' : ''}}" data-value="streetlight" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="看见路灯">
          <view class="pictogram lamp-icon"><view class="lamp-pole"></view><view class="lamp-arm"></view><view class="lamp-shade"></view><view class="lamp-light"></view><view class="lamp-ground"></view></view>
          <text class="choice-label handwritten">Streetlight</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.dog ? 'selected notice-red' : ''}}" data-value="dog" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="Saw a dog">
          <image class="pictogram" src="/assets/notice-dog.svg" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">Dog</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.flower ? 'selected notice-red' : ''}}" data-value="flower" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="Saw a flower">
          <image class="pictogram" src="/assets/notice-flower.svg" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">Flower</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.nothing ? 'selected notice-red' : ''}}" data-value="nothing" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="没有特别留意">
          <view class="pictogram nothing-icon"><view class="dot dot-a"></view><view class="dot dot-b"></view><view class="dot dot-c"></view><view class="dot dot-d"></view><view class="dot dot-e"></view></view>
          <view class="choice-label two-line handwritten"><text>Didn’t</text><text>notice</text></view>
        </button>
      </view>
    </view>

    <view class="form-row distance-row">
      <text class="handwritten field-label">Distance <text class="optional">(optional)</text></text>
      <input class="distance-input handwritten" type="digit" maxlength="5" value="{{distance}}" bindinput="updateDistance" aria-label="跑步距离，可选" />
      <text class="handwritten unit">km</text>
    </view>
    <input class="note-input handwritten" maxlength="80" value="{{note}}" bindinput="updateNote" placeholder="A little note, if you like" placeholder-class="note-placeholder" aria-label="跑步备注，可选" />

    <button class="pill handwritten save-button" hover-class="pressed" bindtap="save" aria-label="{{editing ? '保存修改并返回详情' : '保存本次记录并查看历史记录'}}">{{editing ? 'Save changes →' : 'Save →'}}</button>
    <text class="handwritten helper">You can leave it all blank.</text>
    <button wx:if="{{canContinue}}" class="continue-button handwritten" hover-class="pressed" bindtap="continueRun" aria-label="继续跑，返回本次计时">Keep running</button>
    <button wx:if="{{editing}}" class="discard-button handwritten" hover-class="pressed" bindtap="cancelEdit" aria-label="取消编辑">Cancel</button>
    <button wx:else class="discard-button handwritten" hover-class="pressed" bindtap="discard" aria-label="Discard draft">Discard draft</button>
  </view>
</view>
