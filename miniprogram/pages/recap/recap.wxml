<view class="recap lang-{{language}}" style="--safe-top: {{safeTop}}px;">
  <view class="recap-inner">
    <view class="recap-heading-row">
      <view>
        <text class="handwritten recap-title">{{editing ? copy.edit : copy.so}}</text>
        <text class="handwritten recap-duration">{{durationText}}</text>
      </view>
      <button class="weather-trigger weather-{{weather || 'none'}} {{weatherOpen ? 'open' : ''}}" disabled="{{editing}}" bindtap="toggleWeather" hover-class="choice-pressed" aria-label="{{copy.weather}}：{{weatherLabel}}">
        <image wx:if="{{weather}}" class="weather-image" src="/assets/weather-outline-{{weather}}.png" mode="aspectFit" aria-hidden="true" />
        <text wx:else class="weather-glyph" aria-hidden="true">{{weatherGlyph}}</text>
        <text class="handwritten weather-caption">{{copy.weather}}</text>
      </button>
      <view wx:if="{{weatherOpen}}" class="weather-menu" aria-label="{{copy.weatherMenuAria}}">
        <button class="weather-option {{weather === item.value ? 'selected' : ''}}" wx:for="{{weatherOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseWeather" hover-class="choice-pressed" aria-label="{{item.label}}">
          <image class="weather-option-image" src="/assets/weather-outline-{{item.value}}.png" mode="aspectFit" aria-hidden="true" />
          <text class="handwritten weather-option-label">{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="section mood-section">
      <text class="handwritten section-title">{{copy.howWasIt}}</text>
      <view class="mood-grid">
        <button class="choice mood-choice {{mood === 'good' ? 'selected mood-green' : ''}}" data-value="good" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.good}}">
          <image class="mood-face-image" src="/assets/mood-outline-good.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.good}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'calm' ? 'selected mood-green' : ''}}" data-value="calm" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.calm}}">
          <image class="mood-face-image" src="/assets/mood-outline-calm.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.calm}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'tired' ? 'selected mood-green' : ''}}" data-value="tired" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.tired}}">
          <image class="mood-face-image" src="/assets/mood-outline-tired.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.tired}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'unsure' ? 'selected mood-green' : ''}}" data-value="unsure" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.unsure}}">
          <text class="question-mark handwritten">?</text>
          <image class="mood-face-image" src="/assets/mood-outline-unsure.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.unsure}}</text>
        </button>
      </view>
    </view>

    <view class="section notice-section">
      <text class="handwritten section-title">{{copy.whatNotice}}</text>
      <view class="notice-grid">
        <button class="choice notice-choice {{selectedNotices.tree ? 'selected notice-red' : ''}}" data-value="tree" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.tree}}">
          <image class="pictogram" src="/assets/notice-outline-tree.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.tree}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.wind ? 'selected notice-red' : ''}}" data-value="wind" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.wind}}">
          <image class="pictogram" src="/assets/notice-outline-wind.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.wind}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cloud ? 'selected notice-red' : ''}}" data-value="cloud" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.cloud}}">
          <image class="pictogram" src="/assets/notice-outline-cloud.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.cloud}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cat ? 'selected notice-red' : ''}}" data-value="cat" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.cat}}">
          <image class="pictogram" src="/assets/notice-outline-cat.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.cat}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.streetlight ? 'selected notice-red' : ''}}" data-value="streetlight" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.streetlight}}">
          <image class="pictogram" src="/assets/notice-outline-streetlight.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.streetlight}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.dog ? 'selected notice-red' : ''}}" data-value="dog" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.dog}}">
          <image class="pictogram" src="/assets/notice-outline-dog.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.dog}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.flower ? 'selected notice-red' : ''}}" data-value="flower" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.flower}}">
          <image class="pictogram" src="/assets/notice-outline-flower.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.flower}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.nothing ? 'selected notice-red' : ''}}" data-value="nothing" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.nothingLabel}}">
          <image class="pictogram" src="/assets/notice-outline-nothing.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.nothingLabel}}</text>
        </button>
      </view>
    </view>

    <view class="form-row distance-row">
      <text class="handwritten field-label">{{copy.distance}} <text class="optional">{{copy.optional}}</text></text>
      <input class="distance-input handwritten" type="digit" maxlength="5" value="{{distance}}" placeholder="0.00" bindinput="updateDistance" aria-label="{{copy.distanceInputAria}}" />
      <text class="handwritten unit">km</text>
    </view>
    <input class="note-input handwritten" maxlength="80" value="{{note}}" bindinput="updateNote" placeholder="{{copy.notePlaceholder}}" placeholder-class="note-placeholder" aria-label="{{copy.notePlaceholder}}" />

    <button class="pill handwritten save-button" hover-class="pressed" bindtap="save">{{editing ? copy.saveChanges : copy.save}}</button>
    <button wx:if="{{canContinue}}" class="continue-button handwritten" hover-class="pressed" bindtap="continueRun">{{copy.continueRun}}</button>
    <button wx:if="{{editing}}" class="discard-button cancel-edit-button handwritten" hover-class="pressed" bindtap="cancelEdit">{{copy.cancel}}</button>
    <button wx:else class="discard-button handwritten" hover-class="pressed" bindtap="discard">{{copy.discardDraft}}</button>
    <button wx:if="{{editing}}" class="delete-button handwritten" hover-class="pressed" bindtap="deleteRun">{{copy.deleteRun}}</button>
  </view>
</view>
