<view wx:if="{{!noteEditor}}" class="recap lang-{{language}}" style="--safe-top: {{safeTop}}px;">
  <view class="recap-inner" style="transform: scale({{formScale}}); visibility: {{formReady ? 'visible' : 'hidden'}};">
    <view class="recap-heading-row">
      <view class="recap-heading-inline">
        <text class="handwritten recap-title">{{editing ? copy.edit : copy.so}}</text>
        <text class="handwritten recap-duration">{{durationText}}</text>
      </view>
    </view>

    <view class="section weather-section">
      <text class="handwritten section-title">{{copy.weather}}</text>
      <view class="mood-grid weather-grid">
        <button class="choice mood-choice weather-choice {{weather === item.value ? 'selected mood-green' : ''}}" wx:for="{{weatherOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseWeather" hover-class="choice-pressed" aria-label="{{item.label}}">
          <image class="mood-face-image" src="/assets/weather-outline-{{item.value}}.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="section mood-section">
      <text class="handwritten section-title">{{copy.howWasIt}}</text>
      <view class="mood-grid">
        <button class="choice mood-choice {{mood === 'good' ? 'selected mood-green' : ''}}" data-value="good" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.good}}">
          <image class="mood-face-image" src="/assets/mood-outline-good.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.good}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'calm' ? 'selected mood-green' : ''}}" data-value="calm" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.calm}}">
          <image class="mood-face-image" src="/assets/mood-outline-calm.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.calm}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'tired' ? 'selected mood-green' : ''}}" data-value="tired" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.tired}}">
          <image class="mood-face-image" src="/assets/mood-outline-tired.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.tired}}</text>
        </button>
        <button class="choice mood-choice {{mood === 'unsure' ? 'selected mood-green' : ''}}" data-value="unsure" bindtap="chooseMood" hover-class="choice-pressed" aria-label="{{copy.unsure}}">
          <text class="question-mark handwritten">?</text>
          <image class="mood-face-image" src="/assets/mood-outline-unsure.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.unsure}}</text>
        </button>
      </view>
    </view>

    <view class="section notice-section">
      <text class="handwritten section-title">{{copy.whatNotice}}</text>
      <view class="notice-grid">
        <button class="choice notice-choice {{selectedNotices.tree ? 'selected notice-red' : ''}}" data-value="tree" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.tree}}">
          <image class="pictogram" src="/assets/notice-color-tree.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.tree}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.people ? 'selected notice-red' : ''}}" data-value="people" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.people}}">
          <image class="pictogram" src="/assets/notice-color-people.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten people-label">{{copy.people}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cloud ? 'selected notice-red' : ''}}" data-value="cloud" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.cloud}}">
          <image class="pictogram" src="/assets/notice-color-cloud.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.cloud}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.cat ? 'selected notice-red' : ''}}" data-value="cat" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.cat}}">
          <image class="pictogram" src="/assets/notice-color-cat.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.cat}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.streetlight ? 'selected notice-red' : ''}}" data-value="streetlight" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.streetlight}}">
          <image class="pictogram" src="/assets/notice-color-streetlight.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.streetlight}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.dog ? 'selected notice-red' : ''}}" data-value="dog" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.dog}}">
          <image class="pictogram" src="/assets/notice-color-dog.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.dog}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.flower ? 'selected notice-red' : ''}}" data-value="flower" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.flower}}">
          <image class="pictogram" src="/assets/notice-color-flower.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.flower}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.car ? 'selected notice-red' : ''}}" data-value="car" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.car}}">
          <image class="pictogram" src="/assets/notice-color-car.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.car}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.bicycle ? 'selected notice-red' : ''}}" data-value="bicycle" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.bicycle}}">
          <image class="pictogram" src="/assets/notice-color-bicycle.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.bicycle}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.bird ? 'selected notice-red' : ''}}" data-value="bird" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.bird}}">
          <image class="pictogram" src="/assets/notice-color-bird.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.bird}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.house ? 'selected notice-red' : ''}}" data-value="house" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.house}}">
          <image class="pictogram" src="/assets/notice-color-house.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.house}}</text>
        </button>
        <button class="choice notice-choice {{selectedNotices.nothing ? 'selected notice-red' : ''}}" data-value="nothing" bindtap="chooseNotice" hover-class="choice-pressed" aria-label="{{copy.nothingLabel}}">
          <image class="pictogram" src="/assets/notice-color-nothing.png" mode="aspectFit" aria-hidden="true" />
          <text class="choice-label handwritten">{{copy.nothingLabel}}</text>
        </button>
      </view>
    </view>

    <view class="form-row distance-row">
      <text class="handwritten field-label">{{copy.distance}} <text class="optional">{{copy.optional}}</text></text>
      <input class="distance-input handwritten" always-embed="{{true}}" type="digit" maxlength="5" value="{{distance}}" placeholder="0.00" bindinput="updateDistance" aria-label="{{copy.distanceInputAria}}" />
      <text class="handwritten unit">km</text>
    </view>

    <button class="pill handwritten save-button" hover-class="pressed" bindtap="openNote">{{editing ? copy.saveChanges : copy.save}}</button>
    <view class="recap-secondary-actions">
    <button wx:if="{{canContinue}}" class="continue-button handwritten" hover-class="pressed" bindtap="continueRun">{{copy.continueRun}}</button>
    <button wx:if="{{editing}}" class="discard-button cancel-edit-button handwritten" hover-class="pressed" bindtap="cancelEdit">{{copy.cancel}}</button>
    <button wx:else class="discard-button handwritten" hover-class="pressed" bindtap="discard">{{copy.discardDraft}}</button>
    <button wx:if="{{editing}}" class="delete-button handwritten" hover-class="pressed" bindtap="deleteRun">{{copy.deleteRun}}</button>
    </view>
  </view>
</view>

<view wx:if="{{noteEditor}}" class="note-editor lang-{{language}}" style="padding-top: {{safeTop}}px;">
  <view class="note-editor-header"><button class="note-done" bindtap="closeNote">{{copy.noteBack}}</button><button class="note-done" bindtap="save">{{copy.noteDone}}</button></view>
  <text class="note-editor-title">{{copy.noteTitle}}</text>
  <view class="note-tabs"><button class="note-tab {{noteMode === 'text' ? 'note-active' : ''}}" data-mode="text" bindtap="noteMode">{{copy.noteText}}</button><button class="note-tab {{noteMode === 'draw' ? 'note-active' : ''}}" data-mode="draw" bindtap="noteMode">{{copy.noteDraw}}</button></view>
  <view wx:if="{{noteMode === 'text'}}" class="note-text-panel"><textarea class="note-textarea" value="{{note}}" maxlength="80" bindinput="updateNote" placeholder="{{copy.notePlaceholder}}" adjust-position="{{true}}" cursor-spacing="24" /><text class="note-count">{{note.length}} / 80</text></view>
  <view wx:else class="note-draw-panel">
    <view class="note-tools"><button class="note-tool {{penTool === 'pen' ? 'note-active' : ''}}" data-tool="pen" bindtap="selectPen" aria-label="{{copy.pen}}{{penTool === 'pen' ? copy.selected : ''}}"><image class="note-tool-icon" src="/assets/tools/pen.svg" mode="aspectFit" /></button><button class="note-tool {{penTool === 'eraser' ? 'note-active' : ''}}" data-tool="eraser" bindtap="selectPen" aria-label="{{copy.eraser}}{{penTool === 'eraser' ? copy.selected : ''}}"><image class="note-tool-icon" src="/assets/tools/eraser.svg" mode="aspectFit" /></button><button class="note-tool" disabled="{{!noteDrawing.length}}" bindtap="undoDrawing" aria-label="{{copy.undo}}"><image class="note-tool-icon {{!noteDrawing.length ? 'note-tool-disabled' : ''}}" src="/assets/tools/undo.svg" mode="aspectFit" /></button></view>
    <view class="pen-palette" aria-label="{{copy.colorsLabel}}">
      <button wx:for="{{penColors}}" wx:key="value" class="pen-color {{penColor === item.value ? 'pen-color-selected' : ''}}" data-color="{{item.value}}" bindtap="selectColor" aria-label="{{copy.colors[index]}}{{penColor === item.value ? copy.selected : ''}}"><view class="pen-swatch" style="background-color: {{item.value}};"></view></button>
    </view>
    <button class="custom-color-toggle" bindtap="toggleColorPicker" aria-label="{{copy.customColor}}"><view class="custom-color-preview" style="background-color: {{penColor}};"></view><text>{{colorPickerOpen ? copy.closePalette : copy.customColor}}</text></button>
    <view wx:if="{{colorPickerOpen}}" class="custom-color-panel">
      <view class="custom-color-heading"><text>{{copy.colorPreview}}</text><text>{{penColor}}</text></view>
      <view class="color-channel"><text>{{copy.redChannel}}</text><slider min="0" max="255" step="1" value="{{colorRed}}" data-channel="colorRed" bindchanging="changeColorChannel" bindchange="changeColorChannel" activeColor="#c96358" backgroundColor="#e8e8e5" block-size="24" aria-label="{{copy.redChannel}}" /><text class="color-value">{{colorRed}}</text></view>
      <view class="color-channel"><text>{{copy.greenChannel}}</text><slider min="0" max="255" step="1" value="{{colorGreen}}" data-channel="colorGreen" bindchanging="changeColorChannel" bindchange="changeColorChannel" activeColor="#75927b" backgroundColor="#e8e8e5" block-size="24" aria-label="{{copy.greenChannel}}" /><text class="color-value">{{colorGreen}}</text></view>
      <view class="color-channel"><text>{{copy.blueChannel}}</text><slider min="0" max="255" step="1" value="{{colorBlue}}" data-channel="colorBlue" bindchanging="changeColorChannel" bindchange="changeColorChannel" activeColor="#3d91d0" backgroundColor="#e8e8e5" block-size="24" aria-label="{{copy.blueChannel}}" /><text class="color-value">{{colorBlue}}</text></view>
    </view>
    <view class="note-paper"><drawing-board strokes="{{noteDrawing}}" editable="{{true}}" full-message="{{copy.drawingFull}}" tool="{{penTool}}" color="{{penColor}}" bindchange="updateDrawing" /></view>
    <text class="note-hint">{{copy.drawingHint}}</text>
  </view>
</view>
