<view class="screen run" style="--safe-top: {{safeTop}}px;">
  <text class="handwritten headline">{{paused ? 'Take a breath.' : 'Out there.'}}</text>
  <text class="handwritten timer" aria-label="演示时长，8分21秒">00:08:21</text>
  <view class="run-art"><image class="runner run-runner" src="/assets/runner.png" mode="aspectFit" aria-hidden="true" /></view>
  <view class="actions run-actions">
    <button class="pill handwritten" hover-class="pressed" bindtap="togglePause" aria-label="{{paused ? '继续跑步演示' : '暂停跑步演示'}}">{{paused ? 'Resume' : 'Pause'}}</button>
    <button class="return-link handwritten" hover-class="pressed" bindtap="finish" aria-label="结束演示，填写跑后记录">I'm back</button>
  </view>
</view>
