<view class="screen run lang-{{language}}" style="--safe-top: {{safeTop}}px;">
  <text class="handwritten headline">{{paused ? copy.breath : copy.moving}}</text>
  <text class="handwritten timer" aria-label="{{copy.timeAria}} {{elapsedText}}">{{elapsedText}}</text>
  <view class="run-distance">
    <text class="distance-value">{{distanceText}} km</text>
    <button wx:if="{{!paused && gpsStatus === 'unavailable'}}" class="gps-status gps-settings" bindtap="retryLocation">{{copy.gpsUnavailable}}</button>
    <text wx:else class="gps-status">{{paused ? copy.gpsPaused : gpsStatus === 'ready' ? copy.gpsReady : gpsStatus === 'weak' ? copy.gpsWeak : copy.gpsLocating}}</text>
    <text wx:if="{{distanceIncomplete}}" class="gps-status">{{copy.gpsPartial}}</text>
  </view>
  <view class="run-art"><image class="runner run-runner {{paused ? 'is-paused' : 'is-running'}}" src="/assets/logo-runner.png" mode="aspectFit" aria-hidden="true" /></view>
  <view class="actions run-actions">
    <button class="pill handwritten" hover-class="pressed" bindtap="togglePause" aria-label="{{paused ? copy.resumeAria : copy.pauseAria}}">{{paused ? copy.resume : copy.pause}}</button>
    <button class="return-link handwritten" hover-class="pressed" bindtap="finish" aria-label="{{copy.doneAria}}">{{copy.done}}</button>
  </view>
</view>
