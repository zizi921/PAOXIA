<view class="history" style="--safe-top: {{safeTop}}px;">
  <view class="history-header">
    <view class="title-row">
      <text class="handwritten history-title">Days Out.</text>
      <view class="filter-mark" aria-hidden="true"><view></view><view></view><view></view></view>
    </view>
    <view class="mode-tabs" role="tablist">
      <button class="mode-tab handwritten {{mode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="switchMode" hover-class="choice-pressed">Year</button>
      <text class="tab-divider">|</text>
      <button class="mode-tab handwritten {{mode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchMode" hover-class="choice-pressed">Month</button>
      <text class="tab-divider">|</text>
      <button class="mode-tab handwritten {{mode === 'day' ? 'active' : ''}}" data-mode="day" bindtap="switchMode" hover-class="choice-pressed">Day</button>
    </view>
    <view class="period-nav">
      <button class="period-arrow handwritten" data-direction="-1" bindtap="stepPeriod" hover-class="choice-pressed" aria-label="上一时间段">‹</button>
      <picker wx:if="{{mode === 'month'}}" class="month-picker" mode="date" fields="month" value="{{monthValue}}" start="2020-01" end="2035-12" bindchange="chooseMonth" aria-label="筛选月份">
        <view class="period-copy month-period-copy"><text class="handwritten period-label">{{periodLabels.month}}</text><text class="handwritten month-filter-caret" aria-hidden="true">⌄</text></view>
      </picker>
      <view wx:elif="{{mode === 'day'}}" class="period-copy day-date-stack">
        <picker class="day-picker" mode="date" value="{{dayValue}}" start="2020-01-01" end="2035-12-31" bindchange="chooseDay" aria-label="筛选日期">
          <view class="day-period-copy"><text class="handwritten period-label">{{periodLabels.day}}</text><text class="handwritten day-filter-caret" aria-hidden="true">⌄</text></view>
        </picker>
      </view>
      <view wx:else class="period-copy"><text class="handwritten period-label">{{periodLabels[mode]}}</text></view>
      <button class="period-arrow handwritten" data-direction="1" bindtap="stepPeriod" hover-class="choice-pressed" aria-label="下一时间段">›</button>
    </view>
  </view>

  <view class="history-content">
    <block wx:if="{{mode === 'month'}}">
      <view class="summary month-summary">
        <view><text class="handwritten summary-line">6 times out.</text><text class="handwritten summary-line">2 h 47 min.</text></view>
        <image class="summary-runner month-rest-runner" src="/assets/runner-rest.png" mode="aspectFit" aria-hidden="true" />
      </view>
      <scroll-view class="record-list scroll-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="record-row" role="button" aria-label="查看 {{item.day}} 跑步记录" wx:for="{{monthRows}}" wx:key="day" bindtap="openDay" hover-class="row-pressed">
          <view class="record-date"><view class="record-date-line"><text class="handwritten record-day">{{item.day}}</text><text class="handwritten record-weekday">{{item.weekday}}</text></view><text class="handwritten record-duration">{{item.duration}}</text><text class="handwritten record-distance">{{item.distance}}</text></view>
          <view class="record-story"><view class="mood-inline"><view class="mini-face {{item.moodType}}"><view class="mini-eyes"></view><view class="mini-mouth"></view></view><text class="handwritten mood-name">{{item.mood}}</text></view><view class="mark-row"><text class="mark {{mark}}" wx:for="{{item.marks}}" wx:for-item="mark" wx:key="*this">{{mark === 'tree' ? '♧' : mark === 'cloud' ? '☁' : mark === 'moon' ? '☾' : mark === 'sun' ? '☀' : mark === 'cat' ? '⌁' : '≋'}}</text></view></view>
          <text class="handwritten row-chevron">›</text>
        </view>
      </scroll-view>
    </block>

    <block wx:elif="{{mode === 'year'}}">
      <view class="summary year-summary"><image class="year-runner" src="/assets/runner.png" mode="aspectFit" aria-hidden="true" /><view><text class="handwritten summary-line">48 times out.</text><text class="handwritten summary-line">18 h 26 min.</text></view></view>
      <scroll-view class="year-list scroll-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="year-row" role="button" aria-label="查看 {{item.month}} 跑步记录" wx:for="{{yearRows}}" wx:key="month" bindtap="openMonth" hover-class="row-pressed"><text class="handwritten year-month">{{item.month}}</text><view class="year-copy"><text class="handwritten">{{item.times}}</text><text class="handwritten year-total">{{item.total}}</text></view><view class="bar-chart level-{{item.level}}"><view></view><view></view><view></view><view></view><view></view></view><text class="handwritten row-chevron">›</text></view>
      </scroll-view>
    </block>

    <view wx:else class="day-detail">
      <view class="day-feature">
        <view class="day-summary-copy">
          <view class="day-stat"><text class="handwritten day-kicker">DAY</text><text class="handwritten day-metric day-weekday-value">{{dayWeekday || 'Sunday'}}</text></view>
          <view class="day-stat"><text class="handwritten day-kicker">TIME OUT</text><text class="handwritten day-metric">52 min</text></view>
          <view class="day-stat"><text class="handwritten day-kicker">DISTANCE</text><text class="handwritten day-metric day-distance">5.2 km</text></view>
        </view>
        <view class="day-summary-illustration" aria-hidden="true"><text class="day-cloud">☁</text><image class="day-runner" src="/assets/runner.png" mode="aspectFit" /></view>
      </view>
      <view class="day-feeling"><text class="handwritten day-kicker">FELT</text><view class="mood-inline"><view class="mini-face good"><view class="mini-eyes"></view><view class="mini-mouth"></view></view><text class="handwritten mood-name">Good</text></view></view>
      <view class="day-notice-block"><text class="handwritten day-section-title">Spotted out there</text><view class="day-notices"><view><text class="big-mark tree">♧</text><text class="handwritten">Tree</text></view><view><text class="big-mark cloud">☁</text><text class="handwritten">Cloud</text></view></view></view>
      <view class="day-note-card"><text class="handwritten quote-mark">“</text><text class="handwritten day-note">Such a beautiful sunset!</text><text class="handwritten quote-mark quote-end">”</text></view>
    </view>
  </view>

  <button class="history-action handwritten" bindtap="goAgain" hover-class="pressed" aria-label="再次开始跑步"><text class="plus">＋</text><text>Go again</text><text class="action-arrow">→</text></button>
</view>
