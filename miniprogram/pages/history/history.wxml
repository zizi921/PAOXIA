<view class="history lang-{{language}}" style="--safe-top: {{safeTop}}px;">
  <view class="history-header">
    <view class="title-row">
      <text class="handwritten history-title">{{copy.title}}</text>
      <button wx:if="{{mode === 'day' && selectedRecord}}" class="edit-button handwritten" bindtap="editRecord" hover-class="choice-pressed">{{copy.edit}}</button>
    </view>
    <view class="mode-tabs" role="tablist">
      <button class="mode-tab handwritten {{mode === 'year' ? 'active' : ''}}" role="tab" aria-selected="{{mode === 'year'}}" data-mode="year" bindtap="switchMode" hover-class="choice-pressed">{{copy.year}}</button>
      <text class="tab-divider">|</text>
      <button class="mode-tab handwritten {{mode === 'month' ? 'active' : ''}}" role="tab" aria-selected="{{mode === 'month'}}" data-mode="month" bindtap="switchMode" hover-class="choice-pressed">{{copy.month}}</button>
      <text class="tab-divider">|</text>
      <button class="mode-tab handwritten {{mode === 'day' ? 'active' : ''}}" role="tab" aria-selected="{{mode === 'day'}}" data-mode="day" bindtap="switchMode" hover-class="choice-pressed">{{copy.day}}</button>
    </view>
    <view class="period-nav">
      <button class="period-arrow handwritten" data-direction="-1" bindtap="stepPeriod" hover-class="choice-pressed" aria-label="{{copy.previous}}">‹</button>
      <picker wx:if="{{mode === 'month'}}" class="month-picker" mode="date" fields="month" value="{{monthValue}}" start="2020-01" end="2035-12" bindchange="chooseMonth" aria-label="{{copy.monthFilter}}">
        <view class="period-copy month-period-copy"><text class="handwritten period-label">{{periodLabels.month}}</text><text class="handwritten month-filter-caret" aria-hidden="true">⌄</text></view>
      </picker>
      <view wx:elif="{{mode === 'day'}}" class="period-copy day-date-stack">
        <picker class="day-picker" mode="date" value="{{dayValue}}" start="2020-01-01" end="2035-12-31" bindchange="chooseDay" aria-label="{{copy.dayFilter}}">
          <view class="day-period-copy"><text class="handwritten period-label">{{periodLabels.day}}</text><text class="handwritten day-filter-caret" aria-hidden="true">⌄</text></view>
        </picker>
      </view>
      <view wx:else class="period-copy"><text class="handwritten period-label">{{periodLabels[mode]}}</text></view>
      <button class="period-arrow handwritten" data-direction="1" bindtap="stepPeriod" hover-class="choice-pressed" aria-label="{{copy.next}}">›</button>
    </view>
  </view>

  <view class="history-content">
    <view wx:if="{{!records.length}}" class="day-empty"><image class="empty-runner" src="/assets/runner-rest.png" mode="aspectFit" aria-hidden="true" /><text class="handwritten empty-title">{{copy.noRuns}}</text><text class="handwritten empty-copy">{{copy.noRunsCopy}}</text><text class="handwritten empty-copy">{{copy.localCopy}}</text></view>
    <block wx:elif="{{mode === 'month'}}">
      <view class="summary month-summary">
        <view><text class="handwritten summary-line">{{monthSummary.times}}</text><text class="handwritten summary-line">{{monthSummary.total}}</text></view>
        <image class="summary-runner month-rest-runner" src="/assets/runner-rest.png" mode="aspectFit" aria-hidden="true" />
      </view>
      <scroll-view class="record-list scroll-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="record-row" role="button" aria-label="{{copy.viewRecord}} {{item.day}}" wx:for="{{monthRows}}" wx:key="id" data-date="{{item.date}}" data-id="{{item.id}}" bindtap="openDay" hover-class="row-pressed">
          <view class="record-date"><view class="record-date-line"><text class="handwritten record-day">{{item.day}}</text><text class="handwritten record-weekday">{{item.weekday}}</text></view><text class="handwritten record-duration">{{item.duration}}</text><text class="handwritten record-distance">{{item.distance}}</text></view>
          <view class="record-story"><view class="mood-inline"><view class="mini-face {{item.moodType}}"><view class="mini-eyes"></view><view class="mini-mouth"></view></view><text class="handwritten mood-name">{{item.mood}}</text></view><view class="mark-row"><block wx:for="{{item.noticeItems}}" wx:for-item="mark" wx:key="label"><image wx:if="{{mark.image}}" class="notice-mark" src="{{mark.image}}" mode="aspectFit" aria-label="{{mark.label}}" /><text wx:else class="mark {{mark.className}}">{{mark.glyph}}</text></block></view></view>
          <text class="handwritten row-chevron">›</text>
        </view>
        <view wx:if="{{!monthRows.length}}" class="history-empty"><text class="handwritten empty-title">{{copy.noMonth}}</text><text class="handwritten empty-copy">{{copy.noMonthCopy}}</text></view>
      </scroll-view>
    </block>

    <block wx:elif="{{mode === 'year'}}">
      <view class="summary year-summary"><image class="year-runner" src="/assets/runner.png" mode="aspectFit" aria-hidden="true" /><view><text class="handwritten summary-line">{{yearSummary.times}}</text><text class="handwritten summary-line">{{yearSummary.total}}</text></view></view>
      <scroll-view class="year-list scroll-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="year-row" role="button" aria-label="{{copy.viewMonth}} {{item.month}}" wx:for="{{yearRows}}" wx:key="value" data-month="{{item.value}}" bindtap="openMonth" hover-class="row-pressed"><text class="handwritten year-month">{{item.month}}</text><view class="year-copy"><text class="handwritten">{{item.timesText}}</text><text class="handwritten year-total">{{item.total}}</text></view><view class="bar-chart level-{{item.level}}"><view></view><view></view><view></view><view></view><view></view></view><text class="handwritten row-chevron">›</text></view>
        <view wx:if="{{!yearRows.length}}" class="history-empty"><text class="handwritten empty-title">{{copy.noYear}}</text><text class="handwritten empty-copy">{{copy.noYearCopy}}</text></view>
      </scroll-view>
    </block>

    <view wx:elif="{{selectedRecord}}" class="day-detail">
      <view class="day-feature">
        <view class="day-summary-copy">
          <view class="day-stat"><text class="handwritten day-kicker">{{copy.dayKicker}}</text><text class="handwritten day-metric day-weekday-value">{{selectedRecord.weekdayLong}}</text></view>
          <view class="day-stat"><text class="handwritten day-kicker">{{copy.timeKicker}}</text><text class="handwritten day-metric">{{selectedRecord.duration}}</text></view>
          <view class="day-stat"><text class="handwritten day-kicker">{{copy.distanceKicker}}</text><text class="handwritten day-metric day-distance">{{selectedRecord.distance}}</text></view>
        </view>
        <view class="day-summary-illustration" aria-hidden="true"><text class="day-cloud {{selectedRecord.weatherClass}}">{{selectedRecord.weatherGlyph}}</text><image class="day-runner" src="/assets/runner.png" mode="aspectFit" /></view>
      </view>
      <view class="day-feeling"><text class="handwritten day-kicker">{{copy.felt}}</text><view class="mood-inline"><view class="mini-face {{selectedRecord.moodType}}"><view class="mini-eyes"></view><view class="mini-mouth"></view></view><text class="handwritten mood-name">{{selectedRecord.mood}}</text></view></view>
      <view class="day-notice-block"><text class="handwritten day-section-title">{{copy.spotted}}</text><view wx:if="{{selectedRecord.noticeItems.length}}" class="day-notices"><view wx:for="{{selectedRecord.noticeItems}}" wx:key="label"><image wx:if="{{item.image}}" class="notice-big-mark" src="{{item.image}}" mode="aspectFit" aria-hidden="true" /><text wx:else class="big-mark {{item.className}}">{{item.glyph}}</text><text class="handwritten">{{item.label}}</text></view></view><text wx:else class="handwritten day-blank-copy">{{copy.nothing}}</text></view>
      <view class="day-note-card {{selectedRecord.note ? '' : 'empty-note'}}"><text class="handwritten quote-mark">“</text><text class="handwritten day-note">{{selectedRecord.note || copy.noNote}}</text><text class="handwritten quote-mark quote-end">”</text></view>
    </view>
    <view wx:else class="day-empty"><image class="empty-runner" src="/assets/runner-rest.png" mode="aspectFit" aria-hidden="true" /><text class="handwritten empty-title">{{copy.noDay}}</text><text class="handwritten empty-copy">{{copy.noDayCopy}}</text></view>
  </view>

  <button class="history-action handwritten" bindtap="goAgain" hover-class="pressed"><text class="plus">＋</text><text>{{copy.goAgain}}</text><text class="action-arrow">→</text></button>
</view>
