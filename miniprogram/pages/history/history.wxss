.history-empty, .day-empty { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 260rpx; padding: 34rpx; text-align: center; }.day-empty { height: 100%; }.empty-runner { width: 260rpx; height: 176rpx; margin-bottom: 18rpx; }.empty-title { display: block; font-size: 42rpx; }.empty-copy { display: block; margin-top: 12rpx; color: #686860; font-size: 30rpx; }
