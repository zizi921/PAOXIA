.history { box-sizing: border-box; min-height: 100vh; padding: max(var(--safe-top, 96px), 88px) 44rpx calc(22rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: #fdfcf9; color: #262622; }
.history-header, .history-content, .history-action { width: 100%; max-width: 650rpx; margin-right: auto; margin-left: auto; }
.title-row { display: flex; align-items: center; justify-content: space-between; }
.history-title { font-size: 78rpx; line-height: 1; }
.filter-mark { width: 42rpx; height: 38rpx; padding: 6rpx 0; }
.filter-mark view { position: relative; width: 38rpx; height: 4rpx; margin: 6rpx 0; border-radius: 50%; background: #262622; }.filter-mark view::after { content: ''; position: absolute; top: -4rpx; width: 11rpx; height: 11rpx; border: 3rpx solid #262622; border-radius: 50%; background: #fdfcf9; }.filter-mark view:nth-child(1)::after, .filter-mark view:nth-child(3)::after { right: 6rpx; }.filter-mark view:nth-child(2)::after { left: 7rpx; }
.mode-tabs { display: flex; align-items: center; justify-content: center; margin-top: 18rpx; }
.mode-tab { box-sizing: border-box; min-width: 132rpx; height: 70rpx; margin: 0 8rpx; padding: 0 22rpx 4rpx; border: 0; border-radius: 50%; background: transparent; color: #262622; font-size: 36rpx; line-height: 1; }.mode-tab::after, .period-arrow::after, .record-row::after, .year-row::after, .history-action::after { border: 0; }.mode-tab.active { background: #e5ecdf; }.tab-divider { color: #8d8d84; font-size: 35rpx; }
.period-nav { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; margin-top: 10rpx; }.period-arrow { width: 64rpx; min-height: 64rpx; margin: 0; padding: 0 0 7rpx; border: 0; background: transparent; color: #262622; font-size: 67rpx; line-height: .8; }.period-copy { display: flex; flex-direction: column; align-items: center; }.period-label { font-size: 42rpx; line-height: 1; }.weekday-label { margin-top: 7rpx; color: #686860; font-size: 28rpx; }
.history-content { flex: 1; min-height: 0; }
.summary { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; min-height: 206rpx; padding: 10rpx 10rpx 12rpx; border-bottom: 3rpx solid #73736c; }.summary-line { display: block; font-size: 47rpx; line-height: 1.2; }.summary-runner { width: 225rpx; height: 175rpx; object-fit: contain; }.year-summary { justify-content: center; gap: 8rpx; }.year-runner { width: 270rpx; height: 184rpx; }
.record-list, .year-list, .day-runs { width: 100%; }.record-row { box-sizing: border-box; display: flex; align-items: center; width: 100%; min-height: 146rpx; margin: 0; padding: 10rpx 2rpx; border: 0; border-bottom: 2rpx solid #c5c3bb; border-radius: 0; background: transparent; color: #262622; text-align: left; }.record-date { flex: 1; min-width: 0; }.record-day, .record-weekday { display: inline; }.record-day { font-size: 36rpx; }.record-weekday { margin-left: 20rpx; color: #5f5f58; font-size: 27rpx; }.record-duration { display: block; margin-top: 5rpx; font-size: 41rpx; line-height: 1; }.record-distance { display: block; margin-top: 8rpx; color: #74746c; font-size: 29rpx; line-height: 1; }.record-story { box-sizing: border-box; width: 235rpx; padding-left: 10rpx; }.mood-inline { display: flex; align-items: center; }.mood-name { margin-left: 10rpx; font-size: 32rpx; white-space: nowrap; }
.mini-face { position: relative; box-sizing: border-box; width: 49rpx; height: 46rpx; border: 4rpx solid #262622; border-radius: 49%; }.mini-eyes::before, .mini-eyes::after { content: ''; position: absolute; top: 15rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: #262622; }.mini-eyes::before { left: 11rpx; }.mini-eyes::after { right: 11rpx; }.mini-mouth { position: absolute; left: 13rpx; bottom: 8rpx; width: 18rpx; height: 9rpx; border-bottom: 3rpx solid #262622; border-radius: 0 0 50% 50%; }.mini-face.calm .mini-eyes::before, .mini-face.calm .mini-eyes::after { width: 10rpx; height: 5rpx; background: transparent; border-bottom: 2rpx solid #262622; }.mini-face.tired .mini-eyes::before, .mini-face.tired .mini-eyes::after { width: 10rpx; height: 3rpx; border-radius: 0; }.mini-face.tired .mini-mouth { border-bottom: 0; border-top: 3rpx solid #262622; border-radius: 50% 50% 0 0; bottom: 5rpx; }
.mark-row { display: flex; align-items: center; min-height: 54rpx; margin-top: 4rpx; }.mark { display: inline-block; min-width: 48rpx; margin-right: 10rpx; font-family: serif; font-size: 48rpx; font-weight: 700; line-height: 1; }.mark.tree, .big-mark.tree, .day-tree { color: #4f8b68; }.mark.cloud, .big-mark.cloud { color: #3d91d0; }.mark.sun { color: #f5ad22; }.mark.cat { color: #262622; }.mark.wind { transform: rotate(-8deg); }.row-chevron { width: 36rpx; font-size: 54rpx; text-align: right; }.row-pressed { opacity: .58; background: rgba(229, 236, 223, .45); }
.year-row { box-sizing: border-box; display: flex; align-items: center; width: 100%; min-height: 112rpx; margin: 0; padding: 8rpx 0; border: 0; border-bottom: 2rpx solid #c5c3bb; border-radius: 0; background: transparent; color: #262622; text-align: left; }.year-month { width: 105rpx; font-size: 39rpx; }.year-copy { flex: 1; min-width: 0; font-size: 31rpx; }.year-total { display: block; margin-top: 4rpx; color: #74746c; font-size: 27rpx; }.bar-chart { display: flex; align-items: flex-end; justify-content: space-between; width: 93rpx; height: 54rpx; margin-right: 15rpx; }.bar-chart view { width: 7rpx; border-radius: 5rpx; background: #5f9272; }.bar-chart view:nth-child(1) { height: 42%; }.bar-chart view:nth-child(2) { height: 76%; }.bar-chart view:nth-child(3) { height: 58%; }.bar-chart view:nth-child(4) { height: 90%; }.bar-chart view:nth-child(5) { height: 66%; }.bar-chart.level-1 view:nth-child(n+2), .bar-chart.level-2 view:nth-child(n+3), .bar-chart.level-3 view:nth-child(n+4), .bar-chart.level-4 view:nth-child(n+5) { opacity: .12; }
.day-scene { position: relative; height: 250rpx; border-bottom: 3rpx solid #73736c; overflow: hidden; }.day-runner { position: absolute; right: 44rpx; bottom: 2rpx; width: 245rpx; height: 220rpx; transform: rotate(80deg) scale(.78); }.day-sun { position: absolute; left: 250rpx; top: 38rpx; width: 48rpx; height: 48rpx; border: 5rpx solid #f5ad22; border-radius: 50%; }.day-cloud { position: absolute; right: 28rpx; top: 34rpx; color: #262622; font-size: 77rpx; }.day-tree { position: absolute; bottom: 6rpx; font-family: serif; font-size: 104rpx; font-weight: 700; }.tree-a { left: 16rpx; }.tree-b { left: 92rpx; font-size: 76rpx; }
.day-feature { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 14rpx 14rpx; }.day-duration { display: block; font-size: 66rpx; line-height: 1; }.day-distance { display: block; margin-top: 9rpx; color: #77766e; font-size: 37rpx; }.day-mood { display: flex; align-items: center; margin-right: 32rpx; }.day-notices { display: flex; gap: 72rpx; padding: 4rpx 44rpx 8rpx; }.day-notices view { display: flex; flex-direction: column; align-items: center; font-size: 33rpx; }.big-mark { font-family: serif; font-size: 92rpx; font-weight: 700; line-height: .9; }.day-note { display: block; min-height: 112rpx; padding: 24rpx 16rpx; border-bottom: 2rpx solid #c5c3bb; font-size: 39rpx; line-height: 1.05; }.day-run-row { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; min-height: 136rpx; padding: 12rpx 8rpx; border-bottom: 2rpx solid #c5c3bb; }.run-time { display: block; font-size: 34rpx; }
.history-action { box-sizing: border-box; display: flex; align-items: center; justify-content: space-around; min-height: 104rpx; margin-top: 20rpx; padding: 0 40rpx 5rpx; border: 4rpx solid #30312a; border-radius: 60rpx 57rpx 63rpx 55rpx; background: #e5ecdf; color: #262622; font-size: 47rpx; line-height: 1; }.plus { font-family: sans-serif; font-size: 56rpx; font-weight: 300; }.action-arrow { font-size: 56rpx; }
@media (max-height: 700px) { .history { padding-top: max(var(--safe-top, 80px), 76px); padding-bottom: calc(12rpx + env(safe-area-inset-bottom)); }.history-title { font-size: 68rpx; }.mode-tabs { margin-top: 10rpx; }.mode-tab { height: 60rpx; }.period-nav { min-height: 66rpx; margin-top: 4rpx; }.summary { min-height: 172rpx; }.summary-runner { height: 145rpx; }.summary-line { font-size: 41rpx; }.record-row { min-height: 121rpx; }.year-row { min-height: 91rpx; }.history-action { min-height: 88rpx; margin-top: 12rpx; }.day-scene { height: 205rpx; }.day-feature { padding-top: 14rpx; }.day-notices { padding-top: 0; padding-bottom: 0; }.day-note { min-height: 80rpx; padding-top: 12rpx; padding-bottom: 12rpx; }.day-run-row { min-height: 112rpx; } }
